{
  "schemaVersion": 1,
  "id": "modernfix",
  "version": "${version}",
  "name": "ModernFix-mVUS",
  "description": "Egregious, yet effective performance improvements for modern Minecraft",
  "authors": [
    "embeddedt", "coredex-source"
  ],
  "contact": {
    "sources": "https://github.com/coredex-source/ModernFix---mVUS",
    "homepage": "https://modrinth.com/mod/modernfix-mvus",
    "issues": "https://github.com/coredex-source/ModernFix---mVUS/issues"
  },
  "license": "LGPL-3.0",
  "icon": "icon.png",
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.kofi": "https://ko-fi.com/coredex",
        "modmenu.github_releases": "https://github.com/coredex-source/ModernFix---mVUS/releases",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/modernfix-mvus"
      }
    }
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.embeddedt.modernfix.ModernFixFabric"
    ],
    "client": [
      "org.embeddedt.modernfix.ModernFixClientFabric"
    ],
    "modmenu": [ "org.embeddedt.modernfix.fabric.modmenu.ModernFixModMenuApiImpl" ],
    "preLaunch": [
      "org.embeddedt.modernfix.ModernFixPreLaunchFabric"
    ]
  },
  "mixins": [
    "modernfix-fabric.mixins.json",
    "modernfix-common.mixins.json"
  ],
  "accessWidener": "modernfix.accesswidener",
  "depends": {
    "minecraft": "${supported_minecraft_versions}",
    "fabricloader": ">=0.16.10"
  },
  "breaks": {
    "dashloader": "<5.0.0-beta.1"
  }
}
